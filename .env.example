# X OAuth (Connect X). Create a Web App / public client in the X developer portal;
# the callback is <origin>/api/xauth/callback.
X_CLIENT_ID=
# only for a confidential client; a public client uses PKCE and leaves this empty
X_CLIENT_SECRET=
# signs the session cookie. Rotating it logs every visitor out at once.
# generate: python3 -c "import secrets,base64;print(base64.b64encode(secrets.token_bytes(48)).decode())"
X_SESSION_SECRET=

# Receipt book storage. See db/receipts.sql for the table and docs/supabase.md for
# the setup. The key MUST be the service role key: the endpoint writes a receipt on
# behalf of a signed-in player, and the table is locked down by row level security.
SUPABASE_URL=
SUPABASE_KEY=

# Read-only: the snapshot the grader scores against lives on the data branch.
GITHUB_TOKEN=
